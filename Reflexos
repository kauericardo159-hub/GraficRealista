-- Configurações de Estilo
local PLAYER_REFLECTANCE = 0.35 -- Brilho nos personagens
local ACC_REFLECTANCE = 0.45    -- Brilho extra nos itens/acessórios
local CLOTHING_TRANS = 0.3      -- Transparência das roupas para o reflexo aparecer

local function polishCharacter(obj)
    -- Ignora scripts e elementos lógicos
    if obj:IsA("LuaSourceContainer") or obj:IsA("Folder") then return end

    -- Detecta se pertence a um Player ou NPC (Bot)
    local model = obj:FindFirstAncestorOfClass("Model")
    local isChar = model and model:FindFirstChildOfClass("Humanoid")
    
    if not isChar then return end -- Foca APENAS em personagens

    if obj:IsA("BasePart") then
        -- Mantém apenas o Neon original (para visores/detalhes que já brilham)
        if obj.Material ~= Enum.Material.Neon then
            
            -- Diferencia o corpo dos acessórios para um visual mais dinâmico
            if obj:FindFirstAncestorOfClass("Accessory") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = ACC_REFLECTANCE
            else
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = PLAYER_REFLECTANCE
            end
        end
    end

    -- Ajuste fino de Texturas (Roupas, Camisas e Calças)
    if obj:IsA("Texture") or obj:IsA("Decal") or obj:IsA("Clothing") then
        -- Protege o rosto para manter a expressão nítida
        if obj.Name:lower() ~= "face" then
            obj.Transparency = CLOTHING_TRANS
        end
    end
end

-- 1. Varredura Global Inicial (Apenas Personagens)
for _, char in pairs(game.Workspace:GetDescendants()) do
    polishCharacter(char)
end

-- 2. Conexão para Novos Players, NPCs ou Itens Equipados
game.Workspace.DescendantAdded:Connect(function(newObj)
    task.wait(0.2) -- Otimizado para não causar lag no Delta
    polishCharacter(newObj)
end)

-- 3. Setup de Iluminação Global (Otimizado para Reflexos)
local Lighting = game:GetService("Lighting")
Lighting.EnvironmentSpecularScale = 1
Lighting.EnvironmentDiffuseScale = 1
Lighting.GlobalShadows = true
-- Brilho ambiente balanceado para não "lavar" as cores
Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120) 

print("✨ RTX High-Fidelity: Players & Bots carregado com sucesso!")
