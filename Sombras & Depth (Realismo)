local Lighting = game:GetService("Lighting")

-- 1. Melhorando a nitidez das sombras sem trocar a tecnologia à força
-- Isso mantém a tecnologia que o desenvolvedor escolheu (preserva o dia/noite)
Lighting.ShadowSoftness = 0.2 -- Sombras mais nítidas e realistas
Lighting.GlobalShadows = true -- Garante que as sombras existam

-- 2. Ativando reflexos e profundidade de luz (Specular)
-- Isso é essencial para o script de reflexo nos players funcionar bem
Lighting.EnvironmentDiffuseScale = 1
Lighting.EnvironmentSpecularScale = 1

-- 3. REMOVIDO: OutdoorAmbient e Ambient fixos.
-- Agora o script NÃO mexe nas cores das sombras, permitindo que o jogo
-- fique escuro de noite e claro de dia conforme o original.

-- 4. Depth of Field (Desfoque de distância - Cinematic)
-- O desfoque ajuda a dar profundidade sem mudar a luz.
local dof = Lighting:FindFirstChild("RTX_DOF") or Instance.new("DepthOfFieldEffect")
dof.Name = "RTX_DOF"
dof.FarIntensity = 0.08 -- Bem sutil para não atrapalhar
dof.FocusDistance = 30
dof.InFocusRadius = 60
dof.NearIntensity = 0 
dof.Parent = Lighting

-- 5. Otimização de Sombras para Mobile/Delta
-- Apenas melhora o mapa de sombras se o jogo permitir, sem forçar o 'Future'
if Lighting.Technology == Enum.Technology.Voxel then
    Lighting.Technology = Enum.Technology.ShadowMap
end

print("✅ System 3: Sombras nítidas e reflexos prontos (Ciclo Dia/Noite livre).")
