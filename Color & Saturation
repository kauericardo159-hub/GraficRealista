-- Configurações Ajustadas (Menos brilho, mais cor)
local SATURATION_LEVEL = 0.35 -- Cores mais vibrantes
local CONTRAST_LEVEL = 0.2    -- Cores mais profundas (pretos mais escuros)
local BRIGHTNESS_LEVEL = -0.05 -- Reduzido para o branco não "estourar"
local BLOOM_INTENSITY = 0.3   -- Brilho mais sutil
local BLOOM_THRESHOLD = 2.5   -- ALTO: Impede que o branco comum brilhe (só Neon brilha)

local Lighting = game:GetService("Lighting")

-- 1. Corretor de Cores (Foco em Profundidade)
local colorCorrection = Lighting:FindFirstChild("RTX_ColorCorrection") or Instance.new("ColorCorrectionEffect")
colorCorrection.Name = "RTX_ColorCorrection"
colorCorrection.Saturation = SATURATION_LEVEL
colorCorrection.Contrast = CONTRAST_LEVEL
colorCorrection.Brightness = BRIGHTNESS_LEVEL -- Brilho negativo ajuda a equilibrar o RTX
colorCorrection.Parent = Lighting

-- 2. Sistema de Bloom (Suave e Seletivo)
local bloom = Lighting:FindFirstChild("RTX_Bloom") or Instance.new("BloomEffect")
bloom.Name = "RTX_Bloom"
bloom.Intensity = BLOOM_INTENSITY
bloom.Size = 10 
bloom.Threshold = BLOOM_THRESHOLD -- O segredo: só brilha o que for MUITO intenso
bloom.Parent = Lighting

-- 3. SunRays (Apenas para profundidade)
local sunRays = Lighting:FindFirstChild("RTX_SunRays") or Instance.new("SunRaysEffect")
sunRays.Name = "RTX_SunRays"
sunRays.Intensity = 0.05 -- Quase imperceptível, apenas para atmosfera
sunRays.Spread = 1
sunRays.Parent = Lighting

-- 4. Limpeza de Exposição (Garante que o branco não brilhe sozinho)
Lighting.ExposureCompensation = -0.1 -- Compensa a iluminação forte do mapa
Lighting.Brightness = 2 -- Brilho interno do motor equilibrado

print("🎨 System 2: Estética Visual Melhorada (Cores Vivas, Sem Estouro).")
