-- Configurações de Estilo (Ajuste fino)
local SATURATION_LEVEL = 0.25 -- Saturação (Cores mais vivas)
local CONTRAST_LEVEL = 0.15   -- Contraste (Cores mais profundas)
local BRIGHTNESS_LEVEL = 0.05 -- Brilho extra leve
local BLOOM_INTENSITY = 0.4   -- Intensidade do brilho nas luzes/neon

local Lighting = game:GetService("Lighting")

-- 1. Criando o Corretor de Cores
local colorCorrection = Lighting:FindFirstChild("RTX_ColorCorrection") or Instance.new("ColorCorrectionEffect")
colorCorrection.Name = "RTX_ColorCorrection"
colorCorrection.Saturation = SATURATION_LEVEL
colorCorrection.Contrast = CONTRAST_LEVEL
colorCorrection.Brightness = BRIGHTNESS_LEVEL
colorCorrection.Parent = Lighting

-- 2. Sistema de Bloom (Efeito de brilho nas partes claras e Neon)
local bloom = Lighting:FindFirstChild("RTX_Bloom") or Instance.new("BloomEffect")
bloom.Name = "RTX_Bloom"
bloom.Intensity = BLOOM_INTENSITY
bloom.Size = 12 -- Espalhamento do brilho
bloom.Threshold = 0.8 -- Só faz brilhar o que for realmente claro
bloom.Parent = Lighting

-- 3. SunRays (Raios de Sol para um visual cinematográfico)
local sunRays = Lighting:FindFirstChild("RTX_SunRays") or Instance.new("SunRaysEffect")
sunRays.Name = "RTX_SunRays"
sunRays.Intensity = 0.1 -- Leve para não atrapalhar a visão
sunRays.Spread = 0.5
sunRays.Parent = Lighting

-- 4. Ajuste de Atmosfera (Opcional, deixa o horizonte mais limpo)
local sky = Lighting:FindFirstChildOfClass("Sky")
if sky then
    -- Se o jogo tiver Sky, limpamos um pouco a névoa para o RTX brilhar
    Lighting.FogEnd = 100000
end

print("System 2: Saturação e Estética Visual Carregados.")
