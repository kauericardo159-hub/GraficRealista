-- Configurações de Estilo (Foco em nitidez e cor)
local SATURATION_LEVEL = 0.25 -- Deixa as cores mais vivas
local CONTRAST_LEVEL = 0.15   -- Melhora a profundidade sem escurecer demais
local BRIGHTNESS_LEVEL = 0.0  -- Neutro para não estourar o branco
local BLOOM_INTENSITY = 0.25  -- Brilho suave apenas em luzes fortes
local BLOOM_THRESHOLD = 2.0   -- Garante que roupas brancas NÃO brilhem

local Lighting = game:GetService("Lighting")

-- 1. Color Correction (Atua como um filtro de lente, não mexe no Fog)
local colorCorrection = Lighting:FindFirstChild("RTX_Color") or Instance.new("ColorCorrectionEffect")
colorCorrection.Name = "RTX_Color"
colorCorrection.Saturation = SATURATION_LEVEL
colorCorrection.Contrast = CONTRAST_LEVEL
colorCorrection.Brightness = BRIGHTNESS_LEVEL
colorCorrection.Parent = Lighting

-- 2. Bloom (Efeito de brilho apenas para materiais Neon e Sol)
local bloom = Lighting:FindFirstChild("RTX_Bloom") or Instance.new("BloomEffect")
bloom.Name = "RTX_Bloom"
bloom.Intensity = BLOOM_INTENSITY
bloom.Size = 8
bloom.Threshold = BLOOM_THRESHOLD -- Ignora cores claras normais
bloom.Parent = Lighting

-- 3. SunRays (Efeito de raios solares dinâmico)
-- Se o jogo já tiver, ele apenas ajusta. Se não tiver, ele cria um bem leve.
local sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect")
sunRays.Intensity = 0.05
sunRays.Spread = 1
sunRays.Parent = Lighting

print("✅ System 2: Filtros aplicados (Fog e Ciclo Dia/Noite preservados).")
